load("@rules_cc//cc:defs.bzl", "cc_test")

package(default_package_metadata = [
    "//:license",
    "//:package_info",
])

cc_test(
    name = "Circle",
    size = "medium",
    timeout = "short",
    srcs = ["Circle.cc"],
    copts = select({
        "//conditions:linux_aarch64": [
            "-Wall",
            "-fno-common",
            "-fstack-clash-protection",
            "-fstack-protector-strong",
            "-mbranch-protection=standard",
            "-std=c++98",
            "-Werror=conversion",
            "-Werror=format-security",
        ],
        "//conditions:linux_x86_64": [
            "-Wall",
            "-fcf-protection=full",
            "-fno-common",
            "-fstack-clash-protection",
            "-fstack-protector-strong",
            "-std=c++98",
            "-Werror=conversion",
            "-Werror=format-security",
        ],
        "@platforms//os:linux": [
            "-Wall",
            "-fno-common",
            "-fstack-clash-protection",
            "-fstack-protector-strong",
            "-std=c++98",
            "-Werror=conversion",
            "-Werror=format-security",
        ],
        "@platforms//os:macos": [
            "-Wall",
            "-fno-common",
            "-fstack-protector-strong",
            "-std=c++98",
            "-Werror=conversion",
            "-Werror=format-security",
        ],
        "@platforms//os:windows": [
            "/guard:cf",
            "/guard:ehcont",
            "/Qspectre",
            "/sdl",
            "/W4",
        ],
        "//conditions:default": [],
    }) + select({
        "//conditions:linux_opt": [
            "-U_FORTIFY_SOURCE",
            "-D_FORTIFY_SOURCE=3",
        ],
        "//conditions:default": [],
    }),
    defines = ["HRVO_OUTPUT_TIME_AND_POSITIONS=0"] + select({
        "//conditions:macos_opt": ["_FORTIFY_SOURCE=3"],
        "//conditions:default": [],
    }),
    dynamic_deps = select({
        "@platforms//os:windows": ["//:HRVO"],
        "//conditions:default": [],
    }),
    linkopts = select({
        "@platforms//os:linux": [
            "-Wl,-z,defs",
            "-Wl,-z,noexecstack",
            "-Wl,-z,now",
            "-Wl,-z,relro",
        ],
        "//conditions:default": [],
    }),
    tags = ["block-network"],
    deps = ["//src:HRVO"],
)
